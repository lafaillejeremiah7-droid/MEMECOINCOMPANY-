__pycache__/
*.pyc
*.db
# SQLite WAL sidecars. Both Database and PaperTrader set journal_mode=WAL, so
# every run produces these next to the ignored *.db file.
*.db-wal
*.db-shm
# Coverage artefacts. The gate is enforced by fail_under, not by a committed file.
.coverage
.coverage.*
htmlcov/
coverage.xml
config.yaml
# Every log, not just memescanner.log. The bot writes dashboard.log and
# scanner.log too, and naming a single file left those two committable -- they
# showed up as untracked in a real deployment. Logs carry mints, candidate
# decisions and fragments of provider responses, so none of them belong in git.
*.log
.pytest_cache/

# Local credentials and private key material.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets*.yaml
secrets*.yml
credentials*.json
service-account*.json
